{
  "name": "ngx-deploy-npm-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "packages/ngx-deploy-npm-e2e/src",
  "implicitDependencies": ["ngx-deploy-npm"],
  "targets": {
    "e2e": {
      "dependsOn": ["^build"],
      "options": {
        "cwd": ".",
        "config": "packages/ngx-deploy-npm-e2e/jest.config.ts",
        "passWithNoTests": true,
        "runInBand": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "coverage": true
        }
      }
    },
    "smoke": {
      "cache": false,
      "options": {
        "cwd": ".",
        "config": "packages/ngx-deploy-npm-e2e/jest.config.ts",
        "testPathPatterns": "smoke.spec.ts",
        "passWithNoTests": true,
        "runInBand": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "coverage": true
        }
      }
    }
  }
}
