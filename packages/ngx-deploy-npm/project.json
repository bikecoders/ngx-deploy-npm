{
  "name": "ngx-deploy-npm",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/ngx-deploy-npm/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "lint-report": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx nx lint ngx-deploy-npm --output-file ../../reports/ngx-deploy-npm/lint-report.info --format=../../tools/sonarqube-linter-reporter.js || true"
      }
    },
    "test": {
      "options": {
        "passWithNoTests": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "coverage": true
        }
      }
    },
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/ngx-deploy-npm",
        "tsConfig": "packages/ngx-deploy-npm/tsconfig.lib.json",
        "packageJson": "packages/ngx-deploy-npm/package.json",
        "main": "packages/ngx-deploy-npm/src/index.ts",
        "assets": [
          "README.md",
          "LICENSE",
          {
            "input": "./packages/ngx-deploy-npm/src",
            "glob": "**/!(*.ts)",
            "output": "./src"
          },
          {
            "input": "docs",
            "glob": "**/(*.png|*.jpg)",
            "output": "./docs"
          },
          {
            "input": "./packages/ngx-deploy-npm/src",
            "glob": "**/*.d.ts",
            "output": "./src"
          },
          {
            "input": "./packages/ngx-deploy-npm",
            "glob": "generators.json",
            "output": "."
          },
          {
            "input": "./packages/ngx-deploy-npm",
            "glob": "executors.json",
            "output": "."
          },
          {
            "input": "./packages/ngx-deploy-npm",
            "glob": "migrations.json",
            "output": "."
          }
        ]
      }
    },
    "deploy": {
      "executor": "./dist/packages/ngx-deploy-npm:deploy",
      "dependsOn": ["build"],
      "options": {
        "distFolderPath": "dist/packages/ngx-deploy-npm",
        "access": "public"
      }
    },
    "deploy:without-build": {
      "executor": "./dist/packages/ngx-deploy-npm:deploy",
      "options": {
        "distFolderPath": "dist/packages/ngx-deploy-npm",
        "access": "public"
      }
    },
    "github": {
      "executor": "@jscutlery/semver:github",
      "options": {
        "tag": "{tag}",
        "notes": "{notes}"
      }
    },
    "version": {
      "executor": "@jscutlery/semver:version",
      "options": {
        "push": true,
        "noVerify": true,
        "postTargets": ["build", "deploy", "github"]
      }
    }
  }
}
